# =============================================================================
# Fullstack Hackathon Template - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env with real secrets.
# =============================================================================

# --- Database -----------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hackathon_db?schema=public"

# --- Redis (optional) --------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth Provider ------------------------------------------------------------
# AUTH_PROVIDER=credentials  # credentials | clerk | nextauth | supabase
# AUTH_SECRET=your-auth-secret-here

# --- Storage Provider ---------------------------------------------------------
# STORAGE_PROVIDER=local  # local | s3 | cloudinary | supabase
# STORAGE_BUCKET=uploads
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_ENDPOINT=

# --- Email Provider -----------------------------------------------------------
# EMAIL_PROVIDER=mailpit  # mailpit | resend | sendgrid | ses
# EMAIL_FROM=noreply@example.com
# MAILPIT_SMTP_HOST=localhost
# MAILPIT_SMTP_PORT=1025
# RESEND_API_KEY=
# SENDGRID_API_KEY=

# --- OTP ----------------------------------------------------------------------
# OTP_MODE=mock  # mock | real
# OTP_EXPIRY_SECONDS=300
# OTP_MAX_ATTEMPTS=5

# --- Payment Provider ---------------------------------------------------------
# PAYMENT_PROVIDER=mock  # mock | razorpay | stripe
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- AI Provider --------------------------------------------------------------
# AI_PROVIDER=openai  # openai | anthropic | google | mock
# AI_MODEL=gpt-4o-mini
# AI_MAX_STEPS=10
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- AI Observability ---------------------------------------------------------
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=

# --- Voice & Realtime ---------------------------------------------------------
NEXT_PUBLIC_VOICE_MODE=mock # mock | vapi
NEXT_PUBLIC_VOICE_MODEL=gpt-4o-mini
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
VAPI_API_KEY=
MINIMAX_API_KEY=

# --- Feature Flags ------------------------------------------------------------
FEATURE_AUTH=true
FEATURE_VOICE=false
FEATURE_OTP=false
FEATURE_EMAIL=false
FEATURE_STORAGE=false
FEATURE_PAYMENTS=false
FEATURE_REDIS=false
FEATURE_AI=false
FEATURE_RAG=false
FEATURE_AGENTS=false
FEATURE_MCP=false
FEATURE_ANALYTICS=false
FEATURE_DEMO_MODE=true

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Hackathon App"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
